# 体积大、可再生的产物
design/
e2e/shots/
e2e/live-shots/
e2e/live/shots/

# 打包与二进制
*.zip
*.pdf

# 敏感信息：绝不能入库
api/config.php
install.lock
# 每日快照：整站隐私数据，只存在服务器和本机，不进版本库
backups/

# 非项目代码
beifen-dsh/
.workbuddy/
.impeccable/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 测试产物
e2e/*.json
e2e/*.log
e2e/*.html
e2e/*.png

# 临时工作目录（验证脚本的中间产物）
.tmp*/
.tmp-*.py

# 本地调试用的预览稿与本地服务器状态（都不是产品代码，绝不进包）
_preview-*.html
tools/.local-dev-state.json
tools/.local-dev-state.json.tmp

# Python 缓存
__pycache__/
*.pyc
# 导出的备份含全部隐私数据，只放本地
晚风Todo备份*.json
