# 体积大、可再生的产物
design/
e2e/shots/
e2e/live-shots/

# 打包与二进制
*.zip
*.pdf

# 敏感信息：绝不能入库
api/config.php
install.lock
# 每日快照：整站隐私数据，只存在服务器和本机，不进版本库
backups/

# 非项目代码
beifen-dsh/
.workbuddy/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 测试产物
e2e/*.json
e2e/*.log
e2e/*.html
e2e/*.png

# 临时工作目录（验证脚本的中间产物）
.tmp*/
.tmp-*.py

# Python 缓存
__pycache__/
*.pyc
